# Copy this file to .env and set your own value. Never commit the real file.
# See docs/KEYS.md.

# Base URL of the Wearit backend REST API, without a trailing slash.
# Development: the Vite dev server proxies /api to this URL.
# Production: baked into the build, so rebuild after changing it.
VITE_API_URL=https://api.example.com
