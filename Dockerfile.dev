# Development Dockerfile - optimized for minimal resources
FROM node:24.11.1-slim

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install dependencies and clean cache
RUN --mount=type=cache,target=/root/.npm \
    npm install && \
    npm cache clean --force

# Copy source code
COPY . .

# Dev port (container port = host port; Vite reads PORT)
ENV PORT=4110
EXPOSE 4110

# Start development server
CMD ["npm", "start"]

